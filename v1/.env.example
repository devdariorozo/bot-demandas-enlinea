# ===================================================
# Variables de entorno de ejemplo (NO usar en prod)
# ===================================================

# App
ENV_API=my_env_api
URL_API=my_url_api
PORT_API=my_port_api
GLOBAL_PREFIX=my_global_prefix

# Recursos Docker
NOMBRE_SERVICIO_SWAGGER=my_servicio_swagger
NOMBRE_SERVICIO_DOCKER=my_servicio_docker

# MySQL - BD Configuración
DB_CONFIG_HOST=my_db_config_host
DB_CONFIG_PORT=my_db_config_port
DB_CONFIG_USER=my_db_config_user
DB_CONFIG_PASSWORD=my_db_config_password
DB_CONFIG_DATABASE=my_db_config_database
DB_CONFIG_LOGGING=my_db_config_logging
NOMBRE_SERVICIO_REDIS=my_servicio_redis

# CORS (orígenes permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Browserless (https://www.browserless.io)
BROWSERLESS_ENDPOINT=my_browserless_endpoint
BROWSERLESS_API_TOKEN=my_browserless_api_token

# Redis (opcional - colas BullMQ; con network_mode: host usar localhost)
REDIS_HOST=my_redis_host
REDIS_PORT=my_redis_port

