# App
NODE_ENV=development
PORT=5006

# Browserless (https://www.browserless.io)
BROWSERLESS_ENDPOINT=
BROWSERLESS_API_TOKEN=

# MySQL - BD Configuración
DB_CONFIG_HOST=localhost
DB_CONFIG_PORT=3306
DB_CONFIG_USER=
DB_CONFIG_PASSWORD=
DB_CONFIG_DATABASE=bot_demandas_config

# MySQL - Cartera (ej. Carteras Propias)
DB_CARTERA_HOST=localhost
DB_CARTERA_PORT=3306
DB_CARTERA_USER=
DB_CARTERA_PASSWORD=
DB_CARTERA_DATABASE=

# Redis (opcional - colas BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Horarios laborales (ejemplo; luego configurables)
HORARIO_INICIO_MANANA=08:00
HORARIO_FIN_MANANA=12:00
HORARIO_INICIO_TARDE=13:00
HORARIO_FIN_TARDE=17:00
